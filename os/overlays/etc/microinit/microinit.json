{
  "version": 1,
  "logs": {
    "tty": "/dev/tty2",
    "initTty": "/dev/tty3",
    "lines": 300,
    "dir": "/data/logs",
    "logToFiles": false
  },
  "socket": "/data/run/microinit.sock",
  "socketAllowUsers": [
    "bigfred"
  ],
  "console": "/dev/tty1",
  "openTelemetry": {
    "enable": false,
    "endpoint": "http://127.0.0.1:4318",
    "protocol": "http",
    "serviceName": "microinit",
    "exportIntervalSecs": 15
  },
  "services": []
}
