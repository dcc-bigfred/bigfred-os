{
  "version": 1,
  "logs": {
    "tty": "/dev/tty2",
    "initTty": "/dev/tty3",
    "lines": 300,
    "dir": "/data/logs",
    "logToFiles": false
  },
  "socket": "/data/run/microinit.sock",
  "socketAllowUsers": ["bigfred"],
  "console": "/dev/tty1",
  "openTelemetry": {
    "enable": false,
    "endpoint": "http://127.0.0.1:4318",
    "protocol": "http",
    "serviceName": "microinit",
    "exportIntervalSecs": 15
  },
  "services": [
    {
      "name": "udevd",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 2,
      "startWaitSecs": 2,
      "cmd": "/etc/init.d/udevd",
      "dependsOn": []
    },
    {
      "name": "cron",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 2,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/cron",
      "dependsOn": []
    },
    {
      "name": "network",
      "enabled": true,
      "daemon": false,
      "cmd": "/etc/init.d/network",
      "dependsOn": [],
      "startWaitSecs": 10,
      "livenessProbe": {
        "cmd": "/usr/sbin/configure-ethernet check",
        "successExitCodes": [0],
        "interval": 30
      }
    },
    {
      "name": "sysctl",
      "enabled": true,
      "daemon": false,
      "cmd": "/etc/init.d/sysctl",
      "dependsOn": []
    },
    {
      "name": "redis",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 5,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/redis",
      "dependsOn": ["network"],
      "securityContext": {
        "runAsUser": "redis"
      },
      "livenessProbe": {
        "tcpAddr": "127.0.0.1:6379",
        "interval": 10
      }
    },
    {
      "name": "victoriametrics",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 15,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/victoriametrics",
      "dependsOn": [],
      "securityContext": {
        "runAsUser": "metrics"
      }
    },
    {
      "name": "alloy",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 30,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/alloy",
      "dependsOn": ["network"],
      "securityContext": {
        "runAsUser": "alloy"
      },
      "livenessProbe": {
        "httpUrl": "http://127.0.0.1:12345/-/ready",
        "httpAcceptedCodes": [200],
        "interval": 300
      }
    },
    {
      "name": "remote-icmp",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 15,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/remote-icmp",
      "dependsOn": ["network"]
    },
    {
      "name": "grafana",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 15,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/grafana",
      "dependsOn": ["victoriametrics"],
      "securityContext": {
        "runAsUser": "metrics"
      },
      "livenessProbe": {
        "httpUrl": "http://127.0.0.1:3000/api/health",
        "httpAcceptedCodes": [200],
        "interval": 300
      }
    },
    {
      "name": "bigfred-os-ui",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 10,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/bigfred-os-ui",
      "dependsOn": ["network"]
    },
    {
      "name": "fanctl",
      "enabled": false,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 10,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/fanctl",
      "dependsOn": []
    },
    {
      "name": "bigfred",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 15,
      "startWaitSecs": 1,
      "shutdownWaitSecs": 30,
      "cmd": "/etc/init.d/bigfred",
      "dependsOn": ["network", "redis", "udevd"],
      "securityContext": {
        "runAsUser": "bigfred"
      },
      "livenessProbe": {
        "httpUrl": "http://127.0.0.1:8080/health",
        "httpAcceptedCodes": [200],
        "interval": 60
      }
    },
    {
      "name": "dropbear",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 5,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/dropbear",
      "dependsOn": ["network"],
      "livenessProbe": {
        "tcpAddr": "127.0.0.1:22",
        "interval": 30
      }
    },
    {
      "name": "watchdog",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 5,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/watchdog",
      "dependsOn": []
    }
  ]
}
