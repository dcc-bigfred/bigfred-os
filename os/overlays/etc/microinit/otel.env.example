# Copy to $DATA_DIR/etc/otel.env and uncomment to enable.
# Shared by BigFred (loco-server / dcc-bus) and microinit.
# Process environment wins over this file. CLI flags override both.
#
# If you store secrets (OTEL_EXPORTER_OTLP_HEADERS), restrict the live file:
#   chmod 600 $DATA_DIR/etc/otel.env
#
# ENABLE_TELEMETRY=false
# OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
# # microinit HTTP sibling (Alloy listens on :4318 when telemetry enabled):
# # OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http
# OTEL_SERVICE_NAME=microinit
# OTEL_METRIC_EXPORT_INTERVAL=15000
# OTEL_EXPORTER_OTLP_HEADERS=
