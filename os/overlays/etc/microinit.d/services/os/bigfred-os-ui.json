{
  "services": [
    {
      "name": "bigfred-os-ui",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 10,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/bigfred-os-ui",
      "dependsOn": [
        "network"
      ],
      "livenessProbe": {
        "httpUrl": "http://127.0.0.1:8090/healthz",
        "httpAcceptedCodes": [
          200
        ],
        "interval": 60
      },
      "orderPriority": 220
    }
  ]
}
