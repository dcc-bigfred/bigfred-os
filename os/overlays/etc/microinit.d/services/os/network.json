{
  "services": [
    {
      "name": "network",
      "enabled": true,
      "daemon": true,
      "cmd": "/etc/init.d/network",
      "dependsOn": [],
      "startWaitSecs": 15,
      "livenessProbe": {
        "cmd": "/usr/sbin/micronet check",
        "successExitCodes": [
          0
        ],
        "interval": 20
      },
      "orderPriority": 30
    }
  ]
}
