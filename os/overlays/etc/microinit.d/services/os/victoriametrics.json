{
  "services": [
    {
      "name": "victoriametrics",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "onError",
      "restartBackoff": 15,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/victoriametrics",
      "dependsOn": [
        "network"
      ],
      "securityContext": {
        "runAsUser": "metrics"
      },
      "orderPriority": 120
    }
  ]
}
