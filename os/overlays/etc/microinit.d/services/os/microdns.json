{
  "services": [
    {
      "name": "microdns",
      "enabled": true,
      "daemon": true,
      "restartPolicy": "always",
      "restartBackoff": 60,
      "startWaitSecs": 1,
      "cmd": "/etc/init.d/microdns",
      "dependsOn": [
        "network"
      ],
      "orderPriority": 110
    }
  ]
}
