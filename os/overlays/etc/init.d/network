#!/bin/sh
# Ethernet daemon: micronet serve (DHCP-detect / gateway / static)

MICRONET=/usr/sbin/micronet
IP=/sbin/ip

case "$1" in
start)
	# Redis and local services bind 127.0.0.1 — loopback must be up first.
	"$IP" link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up 2>/dev/null || true

	if [ ! -x "$MICRONET" ]; then
		echo "network: $MICRONET missing" >&2
		exit 1
	fi
	exec "$MICRONET" serve
	;;
stop)
	# Full teardown: stop managed dnsmasq/dhclient and flush the iface.
	# microinit liveness recycle also hits stop then start.
	if [ -x "$MICRONET" ]; then
		"$MICRONET" teardown 2>/dev/null || true
	fi
	killall micronet 2>/dev/null
	killall dnsmasq 2>/dev/null
	killall dhclient 2>/dev/null
	;;
restart)
	$0 stop
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
