#!/bin/sh
# Ethernet daemon: micronet serve (DHCP-detect / gateway / static)

MICRONET=/usr/sbin/micronet
IP=/sbin/ip

case "$1" in
start)
	# Redis and local services bind 127.0.0.1 — loopback must be up first.
	"$IP" link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up 2>/dev/null || true

	if [ ! -x "$MICRONET" ]; then
		echo "network: $MICRONET missing" >&2
		exit 1
	fi
	exec "$MICRONET" serve
	;;
stop)
	# Non-destructive: only stop the daemon and its dnsmasq. Leave
	# dhclient and any acquired lease in place so a liveness restart
	# does not tear down a working DHCP client (micronet reconciles
	# on the next serve).
	killall micronet 2>/dev/null
	killall dnsmasq 2>/dev/null
	;;
restart)
	$0 stop
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
