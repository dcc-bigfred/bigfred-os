#!/bin/sh

DAEMON=/usr/sbin/fanctl

case "$1" in
start)
	[ -x "$DAEMON" ] || exit 0
	# Foreground loop — microinit tracks this PID (restart on crash / killall).
	exec "$DAEMON" daemon
	;;
stop)
	killall fanctl 2>/dev/null
	"$DAEMON" stop 2>/dev/null
	;;
restart)
	$0 stop
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
