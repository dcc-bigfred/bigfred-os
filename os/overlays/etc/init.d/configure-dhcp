#!/bin/sh
# Event WiFi DHCP: start dnsmasq when Omada (or other stack) is on the LAN.
# Runs after microinit service "network".

CONFIGURE=/usr/sbin/configure-dhcp

case "$1" in
start)
	if [ ! -x "$CONFIGURE" ]; then
		echo "configure-dhcp: $CONFIGURE missing" >&2
		exit 1
	fi
	exec "$CONFIGURE" up
	;;
stop)
	# Leave dnsmasq running if started; operator may still need leases.
	exit 0
	;;
restart)
	$0 stop
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
