#!/bin/sh
# BigFred loco-server (dcc-bus is spawned via supervisord as: bigfred dcc-bus …)
# /usr/bin/bigfred resolves /data/opt then /opt.

BIN=/usr/bin/bigfred
PIDFILE=/var/run/bigfred.pid

case "$1" in
start)
	[ -x "$BIN" ] || exit 0
	printf "Starting bigfred: "
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$BIN" --
	taskset -cp 2,3 "$(cat "$PIDFILE")" 2>/dev/null || true
	echo "OK"
	;;
stop)
	printf "Stopping bigfred: "
	start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null
	echo "OK"
	;;
restart)
	$0 stop
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
