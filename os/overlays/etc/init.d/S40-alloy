#!/bin/sh
# Grafana Alloy — optional (BR2_PACKAGE_ALLOY or manual install)

ALLOY_BIN=/usr/bin/alloy
ALLOY_CFG=/etc/alloy/config.alloy

case "$1" in
start)
	[ -x "$ALLOY_BIN" ] || exit 0
	[ -f "$ALLOY_CFG" ] || exit 0
	mkdir -p /data/alloy /data/logs/alloy
	exec taskset -c 0,1 "$ALLOY_BIN" run "$ALLOY_CFG"
	;;
stop)
	killall alloy 2>/dev/null
	;;
restart)
	$0 stop
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
