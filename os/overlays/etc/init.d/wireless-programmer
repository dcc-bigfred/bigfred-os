#!/bin/sh
# wireless-programmer — discovers and programs physical throttle hardware.
# Driven by bigfred / bigfred-wizard over a Unix socket.

# Operator override: /data is RW, /usr/sbin is on the RO rootfs.
if [ -x /data/opt/wireless-programmer/wireless-programmer ]; then
	BIN=/data/opt/wireless-programmer/wireless-programmer
else
	BIN=/usr/sbin/wireless-programmer
fi
SOCK=/data/run/wireless-programmer/wireless-programmer.sock

case "$1" in
start)
	[ -x "$BIN" ] || exit 0
	mkdir -p /data/run/wireless-programmer
	modprobe brcmfmac 2>/dev/null || true
	# Belt and braces: the udev rule normally clears the soft block at boot,
	# but if udevd is degraded a job would fail with a confusing radioBlocked
	# instead of just working. Best-effort, so no failure if rfkill is absent.
	for rf in /sys/class/rfkill/rfkill*/soft; do
		[ -w "$rf" ] && echo 0 >"$rf" 2>/dev/null
	done
	# The daemon has no daemonize path; it stays in the foreground so microinit
	# can track the PID.
	exec "$BIN" --socket "$SOCK"
	;;
stop)
	killall wireless-programmer 2>/dev/null
	;;
restart)
	$0 stop
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
