#!/bin/sh
# BigFred hub OS admin UI (apps/bigfred-os-ui)

# Prefer a writable override on the data partition (Update tab installs here).
if [ -x /data/opt/bigfred/bin/bigfred-os-ui ]; then
	UI_BIN=/data/opt/bigfred/bin/bigfred-os-ui
else
	UI_BIN=/usr/sbin/bigfred-os-ui
fi
UI_CONF=/data/etc/bigfred-os-ui.conf

case "$1" in
start)
	[ -x "$UI_BIN" ] || exit 0
	[ -f "$UI_CONF" ] || {
		echo "S48-bigfred-os-ui: missing $UI_CONF" >&2
		exit 0
	}
	exec "$UI_BIN" --config "$UI_CONF"
	;;
stop)
	killall bigfred-os-ui 2>/dev/null
	;;
restart)
	$0 stop
	$0 start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
