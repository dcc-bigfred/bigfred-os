# Hub OS kernel options — see docs/loconet-adapter/08-hub-os-image.md §8.6
# CONFIG_PREEMPT_RT needs an RT-patched raspberrypi/linux tree; use PREEMPT for now.
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y

CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_BCM2835_WDT=y

# USB serial — LocoNet bridges + central USB VCP + DIY
# Requires udevd (microinit service) for SYMLINK/GROUP/MODE rules.
CONFIG_USB_ACM=y                    # cdc_acm: Digitrax PR3/PR4; RB1110 tty (LI100F unsupported)
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CP210X=y          # Uhlenbrock 63120 (10c4:ea60)
CONFIG_USB_SERIAL_FTDI_SIO=y        # RR-CirKits LocoBuffer*, DR5000/YD7010 USB VCP
CONFIG_USB_SERIAL_PL2303=y          # DIY Prolific USB-UART
CONFIG_USB_SERIAL_CH341=y           # DIY CH340/CH341

# Pi 5 active cooler — pwm-fan driver binds to the cooling_fan DT node and
# exposes /sys/class/thermal/cooling_device0. Without it the PWM pin is not
# claimed and 4-pin PWM fans default to 100%. Thresholds/speeds are set via
# dtparam=fan_temp* in board/bigfred_hub/config.txt (hub spec §8.8).
CONFIG_SENSORS_PWM_FAN=y
CONFIG_THERMAL=y

# ext4 for RO root and RW /data
CONFIG_EXT4_FS=y

# Wireless — used by wireless-programmer to associate to device config APs
# (e.g. NewHeiko WiFred). The hub never joins a WiFi network for internet
# access; the radio is an exclusive, on-demand resource held only while a
# programming job runs. cfg80211 + brcmfmac cover the Pi 3B+/Pi 5 SDIO chip.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# nl80211 userspace (wl-nl80211) needs netlink; build the in-tree vendor
# split rather than a full mac80211 stack (we do not act as a softap/station
# for general traffic — only OpenSystem association to config APs).
# CONFIG_MAC80211 is not set
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# brcmfmac loads firmware/nvram from /lib/firmware/brcm (linux-firmware pkg).
