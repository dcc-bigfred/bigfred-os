# Hub OS kernel options — see docs/loconet-adapter/08-hub-os-image.md §8.6
# CONFIG_PREEMPT_RT needs an RT-patched raspberrypi/linux tree; use PREEMPT for now.
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y

CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_BCM2835_WDT=y

# USB serial — LocoNet bridges + central USB VCP + DIY
# Requires udevd (microinit service) for SYMLINK/GROUP/MODE rules.
CONFIG_USB_ACM=y                    # cdc_acm: Digitrax PR3/PR4; RB1110 tty (LI100F unsupported)
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CP210X=y          # Uhlenbrock 63120 (10c4:ea60)
CONFIG_USB_SERIAL_FTDI_SIO=y        # RR-CirKits LocoBuffer*, DR5000/YD7010 USB VCP
CONFIG_USB_SERIAL_PL2303=y          # DIY Prolific USB-UART
CONFIG_USB_SERIAL_CH341=y           # DIY CH340/CH341

# Pi 5 active cooler — pwm-fan driver binds to the cooling_fan DT node and
# exposes /sys/class/thermal/cooling_device0. Without it the PWM pin is not
# claimed and 4-pin PWM fans default to 100%. Thresholds/speeds are set via
# dtparam=fan_temp* in board/bigfred_hub/config.txt (hub spec §8.8).
CONFIG_SENSORS_PWM_FAN=y
CONFIG_THERMAL=y

# ext4 for RO root and RW /data
CONFIG_EXT4_FS=y

# Wireless — used by wireless-programmer to associate to device config APs
# (e.g. NewHeiko WiFred). The hub never joins a WiFi network for internet
# access; the radio is an exclusive, on-demand resource held only while a
# programming job runs.
#
# brcmfmac is a FullMAC driver: it talks to cfg80211 directly, so no mac80211
# is needed for what we do (OpenSystem association to a config AP). MAC80211 is
# deliberately left at whatever the bcm2712 base defconfig sets rather than
# overridden here — turning it off would also disable any SoftMAC USB adapter a
# user plugs in, for a saving we do not need.
#
# Pi 5 WiFi is CYW43455 on SDIO2 (`compatible = "brcm,bcm2712-sdhci"`). Keep
# the SDHCI host built-in so the SDIO function enumerates, but leave brcmfmac
# as a **module**. Built-in brcmfmac probes in device_initcall, before rootfs
# (and /lib/firmware) exists, firmware request fails with -2, and wlan0 is
# never created. udevd coldplugs the module after / is mounted.
#
# bcm2712_defconfig compresses modules with XZ; musl kmod has failed to load
# those silently on this image, so leave modules uncompressed.
CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# rfkill for /sys/class/rfkill/*/soft, which the udev rule clears at boot.
# RFKILL_INPUT is not enabled: it only handles kill-switch key events, and the
# hub has no such switch.
CONFIG_RFKILL=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_GPIO_BRCMSTB=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_COMPRESS_XZ is not set

# MicroWAF — AF_PACKET sniff + optional XDP enforce (aya).
CONFIG_PACKET=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
